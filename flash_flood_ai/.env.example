# FloodX Environment Variables
# Rename this file to .env and configure for deployment

# MongoDB Atlas Integration (Serverless)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=floodx_prod

# AWS Credentials (For Bedrock Alerting)
# Note: If running on AWS Lambda, use IAM Execution Roles instead of hardcoded keys
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# Model Mode: 'baseline' (Explainable rules) or 'ml' (Random Forest)
FLOODX_MODEL_MODE=ml
